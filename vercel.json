{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.4.5",
      "memory": 2048,
      "maxDuration": 60,
      "regions": [
        "sin1"
      ]
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "BunyadSoft",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "base64:cC3ghZJ0gJwsXeS8huewRDoDjeY+huzgg/HQ9tZqvrw=",
    "APP_VERCEL": "1",
    "DB_CONNECTION": "sqlite",
    "CACHE_DRIVER": "array",
    "SESSION_DRIVER": "cookie",
    "QUEUE_CONNECTION": "sync",
    "LOG_CHANNEL": "stderr",
    "APP_URL": "https://bunyadsoft.vercel.app"
  }
}